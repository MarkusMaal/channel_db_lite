{
    "name": "yiisoft/yii2-app-basic",
    "description": "Kanali andmebaas Lite",
    "keywords": [
        "yii2",
        "channel",
        "database",
        "kanali",
        "andmebaas"
    ],
    "homepage": "https://markusmaal.ee/",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2/issues?state=open",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "source": "https://github.com/yiisoft/yii2"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4.0",
        "yiisoft/yii2": "^2.0.55",
        "yiisoft/yii2-bootstrap5": "^2.0.51",
        "yiisoft/yii2-symfonymailer": "^2.0.4",
        "m35/thecsv": "^1.0.0",
        "phpunit/phpunit": "^13.0"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "^2.1.28",
        "yiisoft/yii2-gii": "^2.2.7",
        "yiisoft/yii2-faker": "^2.0.5",
        "codeception/codeception": "^5.3.5",
        "codeception/lib-innerbrowser": "^4.1.1",
        "codeception/module-asserts": "^3.3.0",
        "codeception/module-yii2": "^1.1.12",
        "codeception/module-filesystem": "^3.0.2",
        "codeception/verify": "^3.4.0",
        "symfony/browser-kit": "^6.4.44"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "advisories": "block"
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}